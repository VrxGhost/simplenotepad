<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <div class="main w-full min-h-screen bg-zinc-900 p-10 text-white">
        <a class="text-blue-500 mb-10" href ="/">go back to home</a>
        <form action="/edit" method="post">
                <input class="block w-full rounded-md outline-none px-5 py-2 bg-zinc-800 text-white" type="text" name="previous" placeholder="previous name" value="<%= filename%>">
                <input class="block w-full rounded-md outline-none px-5 py-2 bg-zinc-800 text-white" type="text" name="new" placeholder="new name">
                <input class="mt-2 px-5 py-2 rounded-md bg-blue-600 text-white cursor-pointer" type="submit" value="Update Name">
            </form>
    </div>
</body>
</html>
